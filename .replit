modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "bash scripts/run-replit-android-sandbox.sh"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-ec", "npm ci --include=dev && uv sync --frozen --python 3.11 && .venv/bin/python3 -c 'import swisseph'"]
run = ["bash", "scripts/run-replit-android-sandbox.sh"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"
YOOKASSA_TEST_MODE = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-replit-android-sandbox.sh"
waitForPort = 5000
